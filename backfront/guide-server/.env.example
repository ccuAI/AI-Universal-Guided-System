# AI 就醫夥伴專用設定：複製成 .env 後填入「你自己的」金鑰
# 與專案根目錄的 .env（醫療早報用的 GPT_API_KEY）互不相通

# 預設：Google Gemini 免費額度（到 https://aistudio.google.com/apikey 申請，不用綁卡）
GUIDE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GUIDE_AI_API_KEY=
# Google 會汰換舊模型：伺服器啟動時若提示找不到模型，照提示換一個名稱
GUIDE_AI_MODEL=gemini-3.1-flash-lite
# 思考程度（none / low / medium / high），越低越快；留空用模型預設
GUIDE_AI_REASONING_EFFORT=

# ── 自動備援（塞車、額度用完、模型下架時依序改用）──
# 同一把金鑰的備援模型，逗號分隔。用 Gemini 時不填會自動使用：
#   gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-flash-latest
# 想自訂就取消下一行的註解；想關掉備援就寫成「GUIDE_AI_FALLBACK_MODELS=」（等號後面留空）
# GUIDE_AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

# 第二家服務（選填，三個都填才會啟用），例如 Groq 免費方案：
# GUIDE_AI_BACKUP_BASE_URL=https://api.groq.com/openai/v1
# GUIDE_AI_BACKUP_API_KEY=
# GUIDE_AI_BACKUP_MODELS=llama-3.3-70b-versatile

# 想換成 OpenAI（需付費）時改成：
# GUIDE_AI_BASE_URL=https://api.openai.com/v1
# GUIDE_AI_MODEL=gpt-4o-mini

# ── 部署到雲端（Google Cloud Run）時的保護，本機開發可以不填 ──
# 通行碼：設定後 App 的「進階設定 → 通行碼」要填一樣的值才能使用
# GUIDE_ACCESS_TOKEN=
# 每台裝置每 10 分鐘最多幾次、每天全部加起來最多幾次
# GUIDE_RATE_LIMIT=120
# GUIDE_DAILY_LIMIT=2000

GUIDE_PORT=3001
